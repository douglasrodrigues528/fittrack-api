# Modelo de configuração da API. Copie para `.env` e ajuste os valores.
# Nunca coloque senhas ou segredos reais neste arquivo: ele é versionado.

# ===== Desenvolvimento local =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<senha-do-seu-postgres>
DB_NAME=fittrack
# Em desenvolvimento, sem JWT_SECRET a API usa um valor padrão e mostra um aviso.
JWT_SECRET=<segredo-aleatorio-longo>
# Origens do frontend liberadas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:3001
PORT=3000

# ===== Produção (defina no painel da hospedagem, nunca no Git) =====
# NODE_ENV=production
# DATABASE_URL=postgres://<usuario>:<senha>@<host>:5432/<banco>
# DB_SSL=true
# DB_SYNCHRONIZE=false
# JWT_SECRET=<obrigatório; 32+ caracteres; gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
# CORS_ORIGINS=https://<seu-app>.vercel.app
# ENABLE_SWAGGER=false
# Atrás de proxy (Render etc.): ativa o limite de tentativas de login por IP com o IP real do cliente.
# TRUST_PROXY=1
# Base das imagens do catálogo (padrão no código: repositório yuhonas/free-exercise-db). Veja DEPLOY.md, seção 6.
# EXERCISE_IMAGES_BASE_URL=

# ===== Testes e2e (passe na linha de comando; use sempre um banco DESCARTÁVEL) =====
# E2E_DB_NAME=fittrack_<algo>_e2e   (o nome precisa terminar em _e2e ou _test)
# E2E_SYNCHRONIZE=false              (testa um banco criado só pelas migrations)
